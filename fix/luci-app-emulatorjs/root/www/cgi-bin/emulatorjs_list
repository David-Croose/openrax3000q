#!/usr/bin/lua
-- EmulatorJS game list CGI v10 (filesystem-only, structured header)
-- Scans roms/ directory, assigns sequential IDs, extracts CAT from extension
-- Output format per entry: @@INF[ID=NNN_CAT=ext]END@@__filename

local base = "/www/luci-static/emulatorjs/roms"
local systems = {"gba", "md", "nes"}

-- Collect all files across all systems, sorted by system then path
local all_files = {}  -- {id, cat, rel_path, filename}

for _, sys in ipairs(systems) do
    local pipe = io.popen('find "' .. base .. '/' .. sys .. '" -type f 2>/dev/null | sort')
    if pipe then
        for full_path in pipe:lines() do
            local rel_path = full_path:sub(#base + 2)  -- e.g., "nes/dir/Super Mario.nes"
            local filename = rel_path:match("([^/]+)$") or rel_path  -- just filename
            local ext = filename:match("%.(%w+)$") or ""           -- extension without dot

            table.insert(all_files, {
                id = #all_files + 1,
                cat = ext,
                rel_path = rel_path,
                filename = filename,
            })
        end
        pipe:close()
    end
end

-- Write ID->path mapping for emulatorjs_rom
local mf = io.open("/tmp/emulatorjs_game_map.lua", "w")
if mf then
    mf:write("local M={\n")
    for _, f in ipairs(all_files) do
        mf:write(string.format("[%d]=%q,\n", f.id, f.rel_path))
    end
    mf:write("}\nreturn M\n")
    mf:close()
end

-- Output JSON array
io.write("Content-Type: application/json; charset=utf-8\r\n\r\n")
io.write("[\n")
for i, f in ipairs(all_files) do
    -- Build structured header string
    local header = string.format("@@INF[ID=%03d_CAT=%s]END@@", f.id, f.cat)

    io.write(string.format(
        '{"id":%d,"header":"%s","name":"%s","cat":"%s"}',
        f.id,
        header,
        f.filename,   -- raw filesystem filename (may be GBK-encoded)
        f.cat
    ))
    if i < #all_files then io.write(",") end
    io.write("\n")
end
io.write("]\n")
