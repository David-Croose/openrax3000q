#!/usr/bin/lua
-- EmulatorJS ROM proxy CGI v5 (ID-based, URL-safe)
-- Receives: id=<number>  (pure ASCII numeric ID)
-- Looks up real path from mapping file generated by emulatorjs_list

local function url_decode(str)
    if not str then return "" end
    str = string.gsub(str, '+', ' ')
    str = string.gsub(str, '%%(%x%x)', function(h) return string.char(tonumber(h, 16)) end)
    return str
end

-- Method 1: ID-based lookup (preferred, pure ASCII)
local id_param = string.match(os.getenv("QUERY_STRING") or "", "id=([^&]*)")
if id_param then
    local game_id = tonumber(id_param)
    if not game_id then
        io.write("Content-Type: text/plain\r\n\r\nError: invalid id")
        os.exit(0)
    end

    -- Load the mapping file
    local map_func, map_err = loadfile("/tmp/emulatorjs_game_map.lua")
    if not map_func then
        io.write("Content-Type: text/plain\r\n\r\nError: game map not found. Please load game list first.")
        os.exit(0)
    end

    local ok, game_map = pcall(map_func)
    if not ok then
        io.write("Content-Type: text/plain\r\n\r\nError: failed to load game map")
        os.exit(0)
    end

    local rel_path = game_map[game_id]
    if not rel_path then
        io.write("Content-Type: text/plain\r\n\r\nError: game id " .. game_id .. " not found")
        os.exit(0)
    end

    -- Security check
    if string.find(rel_path, "%.%.") then
        io.write("Content-Type: text/plain\r\n\r\nError: Access denied")
        os.exit(0)
    end

    -- Build full path and read file
    local base = "/www/luci-static/emulatorjs"
    local full_path = base .. "/" .. rel_path
    local f = io.open(full_path, "rb")

    if f then
        local content = f:read("*a")
        f:close()
        io.write("Content-Type: application/octet-stream\r\n\r\n")
        io.write(content)
        os.exit(0)
    else
        -- Fallback: try find with filename
        local filename = rel_path:match("([^/]+)$") or ""
        local cmd = string.format(
            'find "%s/roms" -name "%s" -type f 2>/dev/null | head -1',
            base, filename
        )
        local pipe = io.popen(cmd)
        local real_path = pipe:read("*l")
        pipe:close()

        if real_path and real_path ~= "" then
            local f2 = io.open(real_path, "rb")
            if f2 then
                local content = f2:read("*a")
                f2:close()
                io.write("Content-Type: application/octet-stream\r\n\r\n")
                io.write(content)
                os.exit(0)
            end
        end

        io.write("Content-Type: text/plain\r\n\r\nError: File not found: " .. rel_path)
        os.exit(0)
    end
end

-- Method 2: Legacy path-based (for backward compatibility)
local path_param = string.match(os.getenv("QUERY_STRING") or "", "path=([^&]*)")
if path_param then
    local decoded = url_decode(path_param)
    local filename = decoded:match("([^/]+)$") or ""

    if filename == "" then
        io.write("Content-Type: text/plain\r\n\r\nError: empty filename")
        os.exit(0)
    end

    local base = "/www/luci-static/emulatorjs"
    local cmd = string.format(
        'find "%s/roms" -maxdepth 3 -name "%s" -type f 2>/dev/null | head -1',
        base, filename
    )
    local pipe = io.popen(cmd)
    local real_path = pipe:read("*l")
    pipe:close()

    if real_path and real_path ~= "" then
        local f = io.open(real_path, "rb")
        if f then
            local content = f:read("*a")
            f:close()
            io.write("Content-Type: application/octet-stream\r\n\r\n")
            io.write(content)
            os.exit(0)
        end
    end

    io.write("Content-Type: text/plain\r\n\r\nError: File not found: " .. filename)
    os.exit(0)
end

io.write("Content-Type: text/plain\r\n\r\nError: missing id or path parameter")
