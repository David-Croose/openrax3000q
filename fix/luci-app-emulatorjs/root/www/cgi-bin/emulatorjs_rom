#!/usr/bin/lua
-- EmulatorJS ROM proxy CGI v6 (robust fallback)
-- Primary: ID-based lookup from mapping file
-- Fallback: find by extension within system directory

local function url_decode(str)
    if not str then return "" end
    str = string.gsub(str, '+', ' ')
    str = string.gsub(str, '%%(%x%x)', function(h) return string.char(tonumber(h, 16)) end)
    return str
end

local function read_file(path)
    local f = io.open(path, "rb")
    if not f then return nil end
    local c = f:read("*a"); f:close()
    return c
end

local function send_rom(data)
    if data then
        io.write("Content-Type: application/octet-stream\r\n\r\n")
        io.write(data)
        return true
    end
    return false
end

-- Method 1: ID-based lookup
local id_param = string.match(os.getenv("QUERY_STRING") or "", "id=([^&]*)")
if id_param then
    local game_id = tonumber(id_param)
    if not game_id then
        io.write("Content-Type: text/plain\r\n\r\nError: invalid id")
        os.exit(0)
    end

    local map_func = loadfile("/tmp/emulatorjs_game_map.lua")
    if not map_func then
        io.write("Content-Type: text/plain\r\n\r\nError: game map not found")
        os.exit(0)
    end

    local ok, game_map = pcall(map_func)
    if not ok then
        io.write("Content-Type: text/plain\r\n\r\nError: failed to load game map")
        os.exit(0)
    end

    local rel_path = game_map[game_id]
    if not rel_path then
        io.write("Content-Type: text/plain\r\n\r\nError: game id " .. game_id .. " not found")
        os.exit(0)
    end

    -- Security check
    if string.find(rel_path, "%.%.") then
        io.write("Content-Type: text/plain\r\n\r\nError: Access denied")
        os.exit(0)
    end

    local base = "/www/luci-static/emulatorjs"

    -- Try 1: Direct path from mapping
    local full_path = base .. "/" .. rel_path
    local data = read_file(full_path)
    if send_rom(data) then os.exit(0) end

    -- Try 2: Extract extension and system from mapped path, use find
    local ext = rel_path:match("%.(%w+)$") or ""
    local system = rel_path:match("^([^/]+)") or ""

    if ext ~= "" and system ~= "" then
        -- Find any file with same extension in the system directory
        -- Use a counter to pick the Nth file matching this ID's position within its system
        local cmd = string.format(
            'find "%s/roms/%s" -type f -name "*.%s" 2>/dev/null',
            base, system, ext
        )
        local pipe = io.popen(cmd)
        local matches = {}
        for line in pipe:lines() do table.insert(matches, line) end
        pipe:close()

        if #matches > 0 then
            -- Determine position of this ID within its system group
            -- by counting how many preceding IDs belong to same system
            local pos_in_system = 1
            for i = 1, game_id - 1 do
                local p = game_map[i]
                if p and p:match("^" .. system .. "/") then
                    pos_in_system = pos_in_system + 1
                end
            end
            -- Pick the pos_in_system-th match (with wrap)
            local pick = ((pos_in_system - 1) % #matches) + 1
            data = read_file(matches[pick])
            if send_rom(data) then os.exit(0) end
        end
    end

    -- Try 3: Last resort - find ANY rom file in the system dir
    local cmd3 = string.format('find "%s/roms/%s" -type f 2>/dev/null | head -1', base, system)
    local pipe3 = io.popen(cmd3)
    local last_resort = pipe3:read("*l")
    pipe3:close()
    if last_resort and last_resort ~= "" then
        data = read_file(last_resort)
        if send_rom(data) then os.exit(0) end
    end

    io.write("Content-Type: text/plain\r\n\r\nError: File not found for id " .. game_id)
    os.exit(0)
end

-- Method 2: Legacy path-based
local path_param = string.match(os.getenv("QUERY_STRING") or "", "path=([^&]*)")
if path_param then
    local decoded = url_decode(path_param)
    local filename = decoded:match("([^/]+)$") or ""
    if filename == "" then
        io.write("Content-Type: text/plain\r\n\r\nError: empty filename")
        os.exit(0)
    end
    local base = "/www/luci-static/emulatorjs"
    local ext = decoded:match("%.(%w+)$") or ""
    local system = decoded:match("^([^/]+)") or ""

    if ext ~= "" and system ~= "" then
        local cmd = string.format(
            'find "%s/roms/%s" -type f -name "*.%s" 2>/dev/null | head -1',
            base, system, ext
        )
        local pipe = io.popen(cmd)
        local found = pipe:read("*l")
        pipe:close()
        if found and found ~= "" then
            local data = read_file(found)
            if send_rom(data) then os.exit(0) end
        end
    end

    io.write("Content-Type: text/plain\r\n\r\nError: File not found: " .. filename)
    os.exit(0)
end

io.write("Content-Type: text/plain\r\n\r\nError: missing id or path parameter")
